AUTH_SECRET=
AUTH_URL=http://localhost:3001
TAKT_PORT=3001
POSTGRES_PASSWORD=takt
# Docker Hub: https://hub.docker.com/r/mrweiland/takt
TAKT_IMAGE=mrweiland/takt
TAKT_VERSION=0.1.5
# Instance OIDC. From the repo: ./deploy/entra-oidc.sh --auth-url "$AUTH_URL" --write deploy/.env
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
# NIS2: set to 1 so org admins with a password must enable an authenticator (see README).
AUTH_REQUIRE_ADMIN_MFA=
S3_ACCESS_KEY=takt
S3_SECRET_KEY=takt-s3-dev
S3_BUCKET=takt-files
S3_REGION=us-east-1
S3_CONSOLE_URL=http://localhost:23646
# Operator opt-in. Also set AI_GATEWAY_API_KEY. VERCEL_OIDC_TOKEN is not consent.
AI_ENABLED=
AI_GATEWAY_API_KEY=
# Optional. Unset = /metrics returns 404.
METRICS_TOKEN=
# Org audit_event retention for ./audit-prune.sh (days). Default 365.
AUDIT_RETENTION_DAYS=365
# Backups: Compose writes dumps every 30 minutes. Restore is Organisation → Backup.
# Work-item files (S3 volume) are not in the dump: ./backup-files.sh writes tarballs here.
FILES_BACKUP_DIR=./file-backups
FILES_BACKUP_KEEP=14
